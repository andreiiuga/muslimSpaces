DATABASE_URL=postgresql://postgres:postgres@localhost:5433/muslimspaces
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3001

# S3-compatible object storage (Railway bucket in production; MinIO locally
# — see the "Local dev: media/bucket" section in CLAUDE.md).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=muslimspaces-media
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_PUBLIC_URL_BASE=http://localhost:9000/muslimspaces-media
