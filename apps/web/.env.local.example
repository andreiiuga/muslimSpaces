# Server-only — used by Server Components / Route Handlers, including
# anything that needs the httpOnly auth cookie (client JS can never read it).
API_BASE_URL=http://localhost:3001

# Public — inlined into the browser bundle. Client components use this for
# public reads only (categories, POI list/map, blog); same backend URL the
# mobile app already calls directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
