{
  "expo": {
    "name": "MuslimSpaces",
    "slug": "muslimspaces",
    "version": "1.0.0",
    "scheme": "muslimspaces",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.muslimspaces",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.anonymous.muslimspaces",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A8560"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ],
    "icon": "./assets/icon.png"
  }
}
