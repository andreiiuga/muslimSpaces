# For Expo Go / simulator on the SAME machine, http://localhost:3001 works.
# On a physical device, "localhost" is the device itself — use your machine's
# LAN IP (e.g. http://192.168.1.42:3001) instead. In production, point this
# at the backend's public Railway URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
