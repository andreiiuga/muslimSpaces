{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Mirrors Metro's runtime resolution order (.native.tsx before .tsx)
    // for plain `tsc` — without this, `pnpm typecheck` would silently
    // check the web variant of every shared component instead.
    "moduleSuffixes": [".native", ""]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
