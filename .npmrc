# @muslimspaces/ui declares react/react-native/lucide-* as peers so it never
# ships its own copy — apps/web (React 19) and apps/mobile (React 18 +
# react-native) each provide their own. pnpm's default auto-install-peers
# defeats this: it unconditionally links a resolved peer into the
# declaring package's own node_modules (ignoring which real consumer
# needs what), which produced a react-native build paired against the
# wrong React major here. Every other dependency in this repo is already
# pinned explicitly, so nothing else relies on auto-install-peers.
auto-install-peers=false
